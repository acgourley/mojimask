.DS_Store

# --- build output (native/.gitignore has cargo's and cmake's; native/packaging/make_app.sh regenerates dist/)
native/dist/

# --- model weights: too big for git, and not all of them may be redistributed.
# models/README.md lists each file, where it comes from, its licence and its SHA-256.
models/**
!models/README.md

# --- people's faces: party videos, frames, crops and test photos never go in the repo
out/
test_clips/*
*.mp4
*.mov
*.m4v
*.MOV
*.MP4
*.heic
*.HEIC
# ...except the sample clip the app ships with (native/packaging/make_app.sh bundles it)
!test_clips/jazz.mp4
# ...and the website's walkthrough of the app on that clip (GitHub Pages serves docs/)
!docs/media/jazz-walkthrough.mp4
# a portrait's measured pose, cached beside the picture
*.pose.json
# every picture, wherever it is saved (a frame or crop written anywhere must not be committed by accident)...
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.JPG
*.JPEG
*.PNG
# ...except the app's own pictures (old paintings, public domain), listed by path
!native/web/assets/gallery/*.jpg
!native/web/assets/icon_art.jpg
!native/web/assets/portrait_mona.png
!docs/media/jazz-walkthrough-poster.jpg
# ...and the website's pictures: public-domain paintings wearing emoji, and the app shown on them
!docs/img/*.webp
!docs/img/social-card.jpg
!docs/img/favicon.png
!docs/img/apple-touch-icon.png

# --- local editor / agent settings (paths on this machine)
.claude/
