#!/bin/bash
# mmctl: drive the running native app through its developer hooks (crates/mm-ctl; `mmctl help`).
# Runs the release binary, building it first when it's missing or older than its source.
NATIVE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BIN="$NATIVE/target/release/mmctl"
if [ ! -x "$BIN" ] || [ -n "$(find "$NATIVE/crates/mm-ctl" -newer "$BIN" -type f -print -quit)" ]; then
    cargo build -q --release -p mm-ctl --manifest-path "$NATIVE/Cargo.toml" || exit 1
fi
exec "$BIN" "$@"
