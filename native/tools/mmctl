#!/usr/bin/env python3
"""mmctl: drive the native app (native/app) through its developer hooks, from the command line. No dependencies.

The app must run with --dev (`mmctl start` does that); it writes its port to out/native/devtools.json.
Every command prints JSON. Exit 1 when the app says no.

  mmctl start [APP ARGS...]       launch the built app with --dev in the background (log: out/native/app.log), wait for
                                  its hooks; e.g. start --video out/poc/clips/jazz_4k.mp4 --data out/poc/data/jazz_4k
  mmctl state [PATH]              the store's state, or the part at a dotted path (editor.video.width)
  mmctl call CMD [JSON]           run a store command as the UI does: call seek '{"t": 40}'; call help
  mmctl tree [--root NAME] [--depth N]       QML items: type, objectName, text, scene rect, visible, enabled, ...
  mmctl find TEXT | --name NAME   items by visible text (exact first, then contains) or objectName
  mmctl click TEXT | --name NAME | X Y        a real mouse click at the item's centre (or at X, Y)
  mmctl drag (--name NAME | --text T | --from X,Y) (--dx DX --dy DY | --to X,Y | --to-name NAME) [--steps N]
  mmctl key KEY                   a real key press: Space, Right, Ctrl+E, A
  mmctl type TEXT                 type text into the focused item
  mmctl eval JS                   evaluate JavaScript in the root QML context: eval 'store.state.editor.t'
  mmctl grab PNG [--name ITEM]    a picture of the window (or one item). The video is greyed unless the clip is public
                                  domain (test_clips/jazz.mp4, out/poc/clips/): AGENTS.md, Privacy
  mmctl reload                    reload the QML now (it also reloads by itself when a file in native/app/qml changes)
  mmctl logs [--since N]          qDebug, QML warnings and Rust's log, in order; "next" is the N for the next call
  mmctl wait JS [--timeout MS]    wait until a JS expression is true: wait 'store.state.editor.playing'
  mmctl perf                      frame times, composite and decode times, QML reload times
  mmctl restart                   relaunch with the same arguments; the store restores its state (open video, frame,
                                  selection, edits) from out/native/state.json
  mmctl rebuild                   cargo build the store dylib, then restart: a Rust change, live (timed)
  mmctl quit
"""
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
INFO = os.path.join(ROOT, "out", "native", "devtools.json")
LOG = os.path.join(ROOT, "out", "native", "app.log")
APP = os.path.join(ROOT, "native", "app", "build", "Mojimask.app", "Contents", "MacOS", "Mojimask")


def out(obj, code=0):
    print(json.dumps(obj, indent=None if isinstance(obj, (int, float, str, bool)) else 1))
    sys.exit(code)


def info():
    try:
        with open(INFO) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def request(route, body=None, query=None, timeout=60, raw=False):
    i = info()
    if not i:
        out({"ok": False, "error": "the app isn't running with --dev (no out/native/devtools.json): mmctl start"}, 1)
    url = i["url"] + route + ("?" + urllib.parse.urlencode(query) if query else "")
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method="POST" if data is not None else "GET",
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            b = r.read()
            return b if raw else json.loads(b)
    except urllib.error.HTTPError as e:
        b = e.read()
        try:
            return json.loads(b)
        except ValueError:
            return {"ok": False, "error": f"HTTP {e.code}: {b[:200]!r}"}
    except (urllib.error.URLError, ConnectionError, TimeoutError) as e:
        return {"ok": False, "error": f"can't reach the app at {url}: {e}"}


def show(r):
    out(r, 0 if r.get("ok", True) else 1)


def wait_up(old_pid=None, timeout=30):
    """Wait until devtools.json names a live process (not old_pid) whose hooks answer."""
    t0 = time.time()
    while time.time() - t0 < timeout:
        i = info()
        if i and i.get("pid") != old_pid and alive(i["pid"]):
            try:
                with urllib.request.urlopen(i["url"] + "/state?path=app", timeout=2) as r:
                    if json.loads(r.read()).get("ok"):
                        return i, time.time() - t0
            except (urllib.error.URLError, ConnectionError, TimeoutError, ValueError):
                pass
        time.sleep(0.05)
    return None, time.time() - t0


def opts(args, *names):
    """Pull --name VALUE options out of args."""
    got = {}
    for n in names:
        if n in args:
            k = args.index(n)
            got[n] = args[k + 1]
            del args[k:k + 2]
    return got


def spec(text=None, name=None, xy=None):
    if name:
        return {"name": name}
    if xy:
        x, y = xy.split(",")
        return {"x": float(x), "y": float(y)}
    return {"text": text}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmd, a = a[0], a[1:]
    if cmd == "start":
        i = info()
        if i and alive(i["pid"]):
            out({"ok": False, "error": f"already running (pid {i['pid']}, port {i['port']}): mmctl quit first"}, 1)
        if not os.path.exists(APP):
            out({"ok": False, "error": f"no app at {APP}: build it (native/README.md)"}, 1)
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        # Paths are the caller's (relative to where mmctl runs), but the app runs in ROOT: make them absolute.
        a = [os.path.abspath(x) if i > 0 and a[i - 1] in ("--video", "--data") and "://" not in x else x
             for i, x in enumerate(a)]
        t0 = time.time()
        with open(LOG, "ab") as log:
            p = subprocess.Popen([APP, "--dev"] + a, cwd=ROOT, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        i, waited = wait_up(timeout=30)
        if not i:
            out({"ok": False, "error": f"the app's hooks didn't come up in 30 s (pid {p.pid}); see {LOG}"}, 1)
        errs = [e["message"] for e in (request("/logs").get("result", {}).get("lines") or []) if e.get("level") == "error"]
        out({"ok": not errs, "pid": i["pid"], "port": i["port"], "seconds": round(waited, 3), "log": LOG,
             **({"errors": errs} if errs else {})}, 1 if errs else 0)
    elif cmd == "state":
        show(request("/state", query={"path": a[0]} if a else None))
    elif cmd == "call":
        if not a:
            out({"ok": False, "error": "call CMD [JSON]"}, 1)
        show(request("/call", {"cmd": a[0], "args": json.loads(a[1]) if len(a) > 1 else {}}))
    elif cmd == "tree":
        o = opts(a, "--root", "--depth")
        q = {k[2:]: v for k, v in o.items()}
        show(request("/tree", query=q or None))
    elif cmd == "find":
        o = opts(a, "--name", "--text")
        q = {"name": o["--name"]} if "--name" in o else {"text": o.get("--text") or " ".join(a)}
        show(request("/find", q))
    elif cmd == "click":
        o = opts(a, "--name", "--text")
        if "--name" in o:
            b = {"name": o["--name"]}
        elif len(a) == 2 and all(x.replace(".", "", 1).lstrip("-").isdigit() for x in a):
            b = {"x": float(a[0]), "y": float(a[1])}
        else:
            b = {"text": o.get("--text") or " ".join(a)}
        show(request("/click", b))
    elif cmd == "drag":
        o = opts(a, "--name", "--text", "--from", "--to", "--to-name", "--dx", "--dy", "--steps")
        b = {"from": spec(o.get("--text"), o.get("--name"), o.get("--from"))}
        if "--to" in o or "--to-name" in o:
            b["to"] = spec(None, o.get("--to-name"), o.get("--to"))
        else:
            b["dx"], b["dy"] = float(o.get("--dx", 0)), float(o.get("--dy", 0))
        if "--steps" in o:
            b["steps"] = int(o["--steps"])
        show(request("/drag", b))
    elif cmd == "key":
        show(request("/key", {"key": a[0]}))
    elif cmd == "type":
        show(request("/type", {"text": " ".join(a)}))
    elif cmd == "eval":
        show(request("/eval", {"js": " ".join(a)}))
    elif cmd == "grab":
        o = opts(a, "--name")
        if not a:
            out({"ok": False, "error": "grab PNG [--name ITEM]"}, 1)
        b = request("/grab", query={"name": o["--name"]} if "--name" in o else None, raw=True)
        if isinstance(b, dict):
            show(b)
        path = os.path.abspath(a[0])
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as f:
            f.write(b)
        w = int.from_bytes(b[16:20], "big") if b[:8] == b"\x89PNG\r\n\x1a\n" else 0
        h = int.from_bytes(b[20:24], "big") if w else 0
        out({"ok": True, "png": path, "width": w, "height": h, "bytes": len(b)})
    elif cmd == "reload":
        show(request("/reload", {}))
    elif cmd == "logs":
        o = opts(a, "--since")
        show(request("/logs", query={"since": o.get("--since", "0")}))
    elif cmd == "wait":
        o = opts(a, "--timeout")
        ms = int(o.get("--timeout", "10000"))
        show(request("/wait", {"js": " ".join(a)}, query={"timeout": ms}, timeout=ms / 1000 + 10))
    elif cmd == "perf":
        show(request("/perf"))
    elif cmd in ("restart", "rebuild"):
        res = {"ok": True}
        t0 = time.time()
        if cmd == "rebuild":
            c = subprocess.run(["cargo", "build", "-p", "mm-app", "--lib"], cwd=os.path.join(ROOT, "native"),
                               capture_output=True, text=True)
            res["cargo_seconds"] = round(time.time() - t0, 2)
            if c.returncode != 0:
                out({"ok": False, "error": "cargo build failed", "stderr": c.stderr[-4000:]}, 1)
        i = info()
        if not i or not alive(i["pid"]):
            out({"ok": False, "error": "the app isn't running: mmctl start", **res}, 1)
        t1 = time.time()
        request("/restart", {})
        j, waited = wait_up(old_pid=i["pid"], timeout=60)
        if not j:
            out({"ok": False, "error": f"the app didn't come back in 60 s; see {LOG}", **res}, 1)
        res.update({"pid": j["pid"], "port": j["port"], "restart_seconds": round(time.time() - t1, 2),
                    "total_seconds": round(time.time() - t0, 2)})
        out(res)
    elif cmd == "quit":
        i = info()
        r = request("/quit", {})
        if i:
            t0 = time.time()
            while alive(i["pid"]) and time.time() - t0 < 10:
                time.sleep(0.05)
        show(r)
    else:
        out({"ok": False, "error": f"no command '{cmd}' (mmctl help)"}, 1)


if __name__ == "__main__":
    main()
