<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for a Developer ID build (see the end of build_mac.sh).
     Not used by the default ad-hoc build, and not yet tested with notarization: these are the ones
     PyInstaller-built Python apps commonly need (CPython and ONNX Runtime map executable memory). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
